<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/asl_background">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/asl_background"
    android:paddingStart="@dimen/screen_spacing"
    android:paddingEnd="@dimen/screen_spacing"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/content_gap"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/content_gap"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/asl_primary"
            android:hint="@string/source_language">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/source_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/asl_text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/asl_primary"
            android:hint="@string/target_language">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/target_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/asl_text"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resizable_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/content_gap">

        <!-- Default height for preview; ResizablePanelController resizes this dynamically -->
        <LinearLayout
            android:id="@+id/camera_panel"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/camera_preview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToOutline="true"
                android:background="@drawable/bg_preview">

                <androidx.camera.view.PreviewView
                    android:id="@+id/camera_surface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible"
                    android:importantForAccessibility="no"
                    app:implementationMode="compatible"
                    app:scaleType="fitCenter" />
                <com.group_nine.asl_translator.home.HandLandmarkOverlay
                    android:id="@+id/hand_landmarks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:id="@+id/camera_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/content_gap"
                    android:background="@drawable/bg_preview">

                <ImageView
                    android:id="@+id/preview_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/asl_primary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/camera_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/camera_placeholder"
                    android:textColor="@color/asl_secondary_text"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:accessibilityLiveRegion="polite" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/camera_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">
            <TextView
                android:id="@+id/live_caption"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="2dp"
                android:text="@string/live_translation"
                android:textColor="@color/asl_secondary_text"
                android:textSize="13sp"
                android:gravity="center"
                android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/switch_camera"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:enabled="false"
                android:text="@string/switch_camera" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/resize_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_target"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/resize_description">

            <View
                android:layout_width="44dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_handle" />
        </FrameLayout>

        <!-- Uses layout_weight="1" with 0dp height to fill remaining space cleanly -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/translation_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/asl_outline"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/asl_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
            <LinearLayout
                android:id="@+id/editor_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vowel_result_title"
                    android:textColor="@color/asl_secondary_text"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/vowel_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vowel_idle"
                    android:textColor="@color/asl_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:accessibilityLiveRegion="polite" />
                <TextView
                    android:id="@+id/speech_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/asl_secondary_text"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/asl_outline" />
            <EditText
                android:id="@+id/translation_output"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:padding="@dimen/card_padding"
                android:hint="@string/text_input_hint"
                android:saveEnabled="false"
                android:textColorHint="@color/asl_secondary_text"
                android:textColor="@color/asl_text"
                android:textSize="17sp"
                android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen"
                android:scrollbars="vertical"
                android:overScrollMode="always"
                android:importantForAutofill="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/camera_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_gap"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_camera"
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginEnd="@dimen/content_gap"
            android:text="@string/start_camera"
            android:textColor="@color/asl_on_primary"
            app:backgroundTint="@color/asl_primary"
            android:paddingStart="@dimen/content_gap"
            android:paddingEnd="@dimen/content_gap"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_camera"
            app:iconTint="@color/asl_on_primary"
            app:iconPadding="8dp"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/microphone"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/microphone"
            android:textColor="@color/asl_text"
            app:strokeColor="@color/asl_outline"
            android:paddingStart="@dimen/content_gap"
            android:paddingEnd="@dimen/content_gap"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_mic"
            app:iconTint="@color/asl_primary"
            app:iconPadding="8dp"
            app:iconGravity="textStart" />
    </LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>
