<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/asl_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_spacing"
        android:paddingEnd="@dimen/screen_spacing"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/content_gap"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/content_gap"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/asl_primary"
                android:hint="@string/source_language"
                >

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/source_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:saveEnabled="false"
                    android:singleLine="true"
                    android:textColor="@color/asl_text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/asl_primary"
                android:hint="@string/target_language">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/target_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:saveEnabled="false"
                    android:singleLine="true"
                    android:textColor="@color/asl_text"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/resizable_space"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/content_gap">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/translation_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/asl_outline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/asl_surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">
                        <TextView
                            android:id="@+id/translation_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:padding="@dimen/card_padding"
                            android:text="@string/translation_input"
                            android:textSize="15sp"
                            android:textColor="@color/asl_secondary_text" />
                    </ScrollView>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/asl_outline" />
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">
                        <TextView
                            android:id="@+id/translation_output"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:padding="@dimen/card_padding"
                            android:text="@string/translation_output"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/asl_text" />
                    </ScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <FrameLayout
                android:id="@+id/resize_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_target"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/resize_description">
                <View
                    android:layout_width="44dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_handle" />

            </FrameLayout>
            <LinearLayout
                android:id="@+id/camera_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/camera_preview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="@dimen/preview_minimum"
                    android:clipToOutline="true"
                    android:background="@drawable/bg_preview">
                    <androidx.camera.view.PreviewView
                        android:id="@+id/camera_surface"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="invisible"
                        android:importantForAccessibility="no"
                        app:implementationMode="compatible"
                        app:scaleType="fillCenter" />
                    <LinearLayout
                        android:id="@+id/camera_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/content_gap"
                        android:background="@drawable/bg_preview">
                    <ImageView
                        android:id="@+id/preview_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/camera_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/camera_placeholder"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:accessibilityLiveRegion="polite" />
                    </LinearLayout>
                </FrameLayout>
                <TextView
                    android:id="@+id/live_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/live_translation"
                    android:textColor="@color/asl_secondary_text"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switch_camera"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:text="@string/switch_camera"
                    android:contentDescription="@string/switch_camera" />
                <LinearLayout
                    android:id="@+id/camera_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/start_camera"
                        android:layout_width="0dp"
                        android:layout_weight="1.3"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_marginEnd="@dimen/content_gap"
                        android:text="@string/start_camera"
                        android:textColor="@color/asl_on_primary"
                        app:backgroundTint="@color/asl_primary"
                        android:paddingStart="@dimen/content_gap"
                        android:paddingEnd="@dimen/content_gap"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_camera"
                        app:iconTint="@color/asl_on_primary"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/microphone"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:text="@string/microphone"
                        android:textColor="@color/asl_text"
                        app:strokeColor="@color/asl_outline"
                        android:paddingStart="@dimen/content_gap"
                        android:paddingEnd="@dimen/content_gap"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_mic"
                        app:iconTint="@color/asl_primary"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>


