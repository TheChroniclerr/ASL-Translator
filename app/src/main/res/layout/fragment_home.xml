<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_spacing"
        android:paddingEnd="@dimen/screen_spacing">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/content_gap"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/content_gap"
                android:hint="@string/source_language">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/source_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:saveEnabled="false"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/target_language">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/target_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:saveEnabled="false"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/resizable_space"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/content_gap">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/translation_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/asl_outline"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/asl_surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">
                        <TextView
                            android:id="@+id/translation_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:padding="@dimen/card_padding"
                            android:text="@string/translation_input"
                            android:textSize="16sp"
                            android:textColor="@color/asl_secondary_text" />
                    </ScrollView>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/asl_outline" />
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">
                        <TextView
                            android:id="@+id/translation_output"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:padding="@dimen/card_padding"
                            android:text="@string/translation_output"
                            android:textSize="16sp"
                            android:textColor="@color/asl_secondary_text" />
                    </ScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <FrameLayout
                android:id="@+id/resize_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_target"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/resize_description">
                <LinearLayout
                    android:layout_width="@dimen/divider_width"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:importantForAccessibility="noHideDescendants">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_bar"
                        android:background="@drawable/bg_handle" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_bar"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_handle" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:id="@+id/camera_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/camera_preview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="@dimen/preview_minimum"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/content_gap"
                    android:background="@drawable/bg_preview">
                    <ImageView
                        android:id="@+id/preview_icon"
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/asl_primary"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/camera_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/camera_placeholder"
                        android:textColor="@color/asl_secondary_text"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:accessibilityLiveRegion="polite" />
                </LinearLayout>
                <TextView
                    android:id="@+id/live_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/content_gap"
                    android:paddingBottom="@dimen/content_gap"
                    android:text="@string/live_translation"
                    android:textColor="@color/asl_secondary_text"
                    android:textSize="14sp"
                    android:accessibilityLiveRegion="polite" />
                <LinearLayout
                    android:id="@+id/camera_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/start_camera"
                        android:layout_width="0dp"
                        android:layout_weight="1.3"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/control_height"
                        android:layout_marginEnd="@dimen/content_gap"
                        android:text="@string/start_camera"
                        android:paddingStart="@dimen/content_gap"
                        android:paddingEnd="@dimen/content_gap"
                        app:cornerRadius="@dimen/control_radius"
                        app:icon="@drawable/ic_camera"
                        app:iconPadding="6dp"
                        app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/microphone"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/control_height"
                        android:text="@string/microphone"
                        android:paddingStart="@dimen/content_gap"
                        android:paddingEnd="@dimen/content_gap"
                        app:cornerRadius="@dimen/control_radius"
                        app:icon="@drawable/ic_mic"
                        app:iconPadding="6dp"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
